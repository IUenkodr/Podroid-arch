# Stage 1: Cross-compile Podroid tools for x86_64
FROM ubuntu:22.04 AS vsock-builder
RUN apt-get update && apt-get install -y build-essential gcc make
WORKDIR /work
COPY build-rootfs/vsock-agent ./vsock-agent
COPY build-rootfs/host-bridge ./host-bridge
COPY build-rootfs/overlay-normalize ./overlay-normalize

RUN cd vsock-agent && make CC=gcc
RUN cd host-bridge && make CC=gcc
RUN cd overlay-normalize && make CC=gcc

# Stage 2: Arch Linux Rootfs Generation
FROM ubuntu:22.04 AS builder
RUN apt-get update && apt-get install -y curl squashfs-tools tar openssl qemu-user-static
WORKDIR /work

# Using an official, high-availability mirror instead of the archive
# We use the aarch64 bootstrap but for an x86_64 guest, 
# we actually need the x86_64 bootstrap.
# Let's use a different mirror that is known to be reliable.
RUN curl -L -o bootstrap.tar.gz https://mirrors.kernel.org/archlinux/iso/latest/archlinux-bootstrap-x86_64.tar.gz \
    && [ -s bootstrap.tar.gz ] \
    && mkdir arch-bootstrap \
    && tar -xzf bootstrap.tar.gz -C arch-bootstrap \
    && rm bootstrap.tar.gz

# Create the actual rootfs using pacstrap
RUN mkdir rootfs && \
    arch-bootstrap/bin/pacstrap -K rootfs base base-devel iproute2 systemd util-linux zram-generator

# Inject compiled binaries
COPY --from=vsock-builder /work/vsock-agent/podroid-vsock-agent /work/rootfs/usr/local/bin/
COPY --from=vsock-builder /work/host-bridge/podroid-hostd /work/rootfs/usr/local/bin/
COPY --from=vsock-builder /work/overlay-normalize/podroid-overlay-normalize /work/rootfs/usr/local/bin/

# Inject the converted Bootstrap script and Systemd units
COPY build-rootfs/scripts/podroid-bootstrap.sh /work/rootfs/etc/podroid-bootstrap.sh
COPY build-rootfs/scripts/podroid-hostd.service /work/rootfs/etc/systemd/system/podroid-hostd.service
RUN chmod +x /work/rootfs/etc/podroid-bootstrap.sh

# Final packaging
RUN mksquashfs /work/rootfs /work/arch-rootfs.squashfs -comp zstd -Xcompression-level 19 -all-root -noappend

FROM scratch AS export
COPY --from=builder /work/arch-rootfs.squashfs /arch-rootfs.squashfs
